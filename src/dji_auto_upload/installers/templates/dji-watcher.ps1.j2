# dji-auto-upload Windows watcher — runs as a Scheduled Task at user logon.
# Subscribes to Win32_VolumeChangeEvent and triggers `dji-auto-upload run` for
# DJI volumes (DCIM-folder match or vendor-ID match).

$ErrorActionPreference = 'Continue'
$VendorIds = @({% for v in vendor_ids %}'{{ v }}'{% if not loop.last %}, {% endif %}{% endfor %})
$Labels    = @({% for l in labels %}'{{ l }}'{% if not loop.last %}, {% endif %}{% endfor %})
$Binary    = '{{ binary }}'

function Test-DjiVolume($drive) {
    if (Test-Path "$drive\DCIM") {
        $children = Get-ChildItem -Path "$drive\DCIM" -Directory -ErrorAction SilentlyContinue
        if ($children) { return $true }
    }
    try {
        $vol = Get-Volume -DriveLetter ($drive[0]) -ErrorAction SilentlyContinue
        if ($vol -and $Labels -contains $vol.FileSystemLabel) { return $true }
    } catch {}
    try {
        $devices = Get-PnpDevice -PresentOnly -ErrorAction SilentlyContinue |
                   Where-Object { $_.InstanceId -match 'USB.*VID_([0-9A-Fa-f]{4})' }
        foreach ($d in $devices) {
            if ($d.InstanceId -match 'VID_([0-9A-Fa-f]{4})') {
                $vid = $matches[1].ToLower()
                if ($VendorIds -contains $vid) { return $true }
            }
        }
    } catch {}
    return $false
}

Register-WmiEvent -Class Win32_VolumeChangeEvent -SourceIdentifier DjiVolumeWatcher -Action {
    $eventType = $Event.SourceEventArgs.NewEvent.EventType
    if ($eventType -ne 2) { return }   # 2 = arrival
    $drive = $Event.SourceEventArgs.NewEvent.DriveName
    Start-Sleep -Seconds 2
    if (Test-DjiVolume $drive) {
        Start-Process $using:Binary -ArgumentList 'run','--device',$drive -WindowStyle Hidden
    }
} | Out-Null

while ($true) { Start-Sleep -Seconds 3600 }
