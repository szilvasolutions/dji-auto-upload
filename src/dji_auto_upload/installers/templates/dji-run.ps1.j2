# dji-auto-upload WORKER — launched HIDDEN and detached by the watcher.
#
# This is the process that actually does the offload. It runs in its own hidden
# console, so no window the user can see or close is attached to it: closing the
# visible progress window (dji-view.ps1) cannot interrupt the transfer.
#
# It shows the final popup itself — because it can't be closed, that popup is
# guaranteed to appear whatever the user does with the progress window.

param([string]$Drive)

& '{{ binary }}' {% for a in pre_args or [] %}'{{ a }}' {% endfor %}run --device $Drive
$code = $LASTEXITCODE

$shell = New-Object -ComObject WScript.Shell
if ($code -eq 0) {
    # 64 = info icon; auto-dismisses after 6 seconds.
    $shell.Popup("DJI offload complete - your footage is in the cloud.", 6, 'DJI Auto Upload', 64) | Out-Null
} elseif ($code -eq 75) {
    # Already running in another window — did nothing. NOT a success, NOT an error.
    $shell.Popup("This drone is already being offloaded in another window.", 6, 'DJI Auto Upload', 48) | Out-Null
} else {
    # 16 = error icon; 0 = stays until dismissed.
    $msg = "DJI offload FAILED (exit code $code).`n`n" +
           "Log file:`n{{ log_file }}`n`n" +
           "For a support bundle to attach to a bug report, run:`n" +
           "dji-auto-upload diagnose"
    $shell.Popup($msg, 0, 'DJI Auto Upload', 16) | Out-Null
}
